flowchart LR
    A["Open transcript"] --> B["Seek backward to requested boundary"]
    B --> C["Read complete JSONL suffix"]
    C --> D["Filter and select fields"]
    D --> E{"Follow enabled?"}
    E -->|No| F["Exit"]
    E -->|Yes| G["Check file identity and length"]
